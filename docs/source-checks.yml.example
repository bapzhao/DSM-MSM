# Optional workflow: copy to .github/workflows/source-checks.yml to enable.
name: Source checks

on:
  push:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  numpy-checks:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Install NumPy
        run: python -m pip install -r requirements-1d.txt
      - name: Check source and numerical identities
        run: python check_source.py
      - name: Check calculation configuration entries
        run: |
          python dsm/run_burgers.py --case dns-reference --dry-run
          python msm/run_ns.py --method msm --dry-run
      - name: Check example launch scripts
        run: |
          bash -n examples/1d/run_les.sh
          bash -n examples/2d/run_msm.sh
